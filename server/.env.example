# API port
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://taxdesk:taxdesk@localhost:5432/taxdesk

# JWT signing secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=dev-secret-change-me

# Allowed CORS origin (frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Razorpay credentials (optional). If omitted, payments run in mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seed credentials for the admin account created by `npm run create-admin`.
# Leave unset to use the defaults (admin@taxdesk.local / admin12345) — change these.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@taxdesk.local
ADMIN_PASSWORD=admin12345

# Email notifications (optional). If SMTP_HOST is unset, emails are printed to
# the server console and recorded in the email_log table (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaxDesk <no-reply@taxdesk.local>

# Document uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Force SSL for the database connection. Left unset, SSL is chosen
# automatically: public hostnames (Render external, Heroku, Supabase, Neon,
# RDS...) use SSL; localhost and Render's internal hostname do not.
# Set to "true" or "false" to override.
PGSSL=
