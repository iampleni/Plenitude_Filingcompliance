# Client (Vite) environment variables.
#
# In development the Vite proxy in vite.config.js forwards /api to
# http://localhost:4000, so this file can stay empty locally.
#
# In production the client is served from a different origin than the API,
# so point it at the API's full URL. Vite inlines VITE_* variables at build
# time — no secrets belong here.
#
# Example (Render):
# VITE_API_URL=https://your-api-service.onrender.com
VITE_API_URL=
